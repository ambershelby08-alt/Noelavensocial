rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Founder UID — hardcoded server-side, never editable from client ─────────
    // This string MUST match FOUNDER_UID in src/lib/founder.ts
    function isFounder() {
      return request.auth != null
          && request.auth.uid == 'OJzzcq17QLRreaEINhQ2czxhtQ23';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Founder OR a user listed in the admins collection
    function isModerator() {
      return isFounder()
          || (isAuthenticated()
              && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();

      // New account creation
      allow create: if isOwner(userId);

      // Self-update: block all role / suspension / ban / founder fields
      allow update: if isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'isFounder', 'isAdmin', 'isModerator',
                       'suspended', 'banned', 'suspendedAt', 'bannedAt']);

      // Founder can update any user (e.g. to set role fields)
      allow update, delete: if isFounder();
    }

    // ── Protected roles document ───────────────────────────────────────────────
    match /roles/{document} {
      allow read:  if isModerator();
      allow write: if isFounder();
    }

    // ── Admin roster ──────────────────────────────────────────────────────────
    match /admins/{userId} {
      allow read:  if isModerator();
      allow write: if isFounder();   // Only Founder grants/revokes moderator roles
    }

    // ── Reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Any authenticated user may create a report for their own UID
      allow create: if isAuthenticated()
          && request.resource.data.reporterId == request.auth.uid;

      // Reporters can read their own submitted reports
      // Moderators can read everything
      allow read: if isModerator()
          || (isAuthenticated() && resource.data.reporterId == request.auth.uid);

      // Only moderators may update status/assignment; reporters cannot touch status
      allow update: if isModerator()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['reporterId', 'targetId', 'reportedUserId']);

      // Only Founder can hard-delete reports
      allow delete: if isFounder();
    }

    // ── Moderation audit log — immutable from client ───────────────────────────
    match /moderationActions/{actionId} {
      allow create: if isModerator();
      allow read:   if isModerator();
      // No update or delete — audit log is append-only
      allow update, delete: if false;
    }

    // ── User suspensions / bans ───────────────────────────────────────────────
    match /userSuspensions/{userId} {
      allow read:  if isOwner(userId) || isModerator();
      allow write: if isModerator();
    }

    // ── Blocks ────────────────────────────────────────────────────────────────
    match /userBlocks/{docId} {
      allow read:   if isAuthenticated()
          && (resource.data.blockerId == request.auth.uid
              || resource.data.blockedId == request.auth.uid);
      allow create: if isAuthenticated()
          && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated()
          && resource.data.blockerId == request.auth.uid;
    }

    // ── Mutes ─────────────────────────────────────────────────────────────────
    match /userMutes/{docId} {
      allow read:   if isAuthenticated()
          && resource.data.muterId == request.auth.uid;
      allow create: if isAuthenticated()
          && request.resource.data.muterId == request.auth.uid;
      allow delete: if isAuthenticated()
          && resource.data.muterId == request.auth.uid;
    }

    // ── Restrictions ──────────────────────────────────────────────────────────
    match /userRestrictions/{docId} {
      allow read:   if isAuthenticated()
          && resource.data.restrictorId == request.auth.uid;
      allow create: if isAuthenticated()
          && request.resource.data.restrictorId == request.auth.uid;
      allow delete: if isAuthenticated()
          && resource.data.restrictorId == request.auth.uid;
    }

    // ── Safety settings ───────────────────────────────────────────────────────
    match /userSafetySettings/{userId} {
      allow read, write: if isOwner(userId) || isModerator();
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.authorId == request.auth.uid)
          || isModerator();
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid)
          || isModerator();

      // Comments are stored as a subcollection of each post
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
            && request.resource.data.authorId == request.auth.uid;
        allow update, delete:
            if (isAuthenticated() && resource.data.authorId == request.auth.uid)
            || isModerator();

        // Replies are nested under each comment
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated()
              && request.resource.data.authorId == request.auth.uid;
          allow update, delete:
              if (isAuthenticated() && resource.data.authorId == request.auth.uid)
              || isModerator();
        }
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Recipient reads and manages their own
      allow read, update, delete: if isAuthenticated()
          && resource.data.userId == request.auth.uid;
      // Any authenticated user may write (send a notification to another user)
      allow create: if isAuthenticated();
    }

    // ── Conversations ─────────────────────────────────────────────────────────
    //
    // Helper: safely check conversation participant membership.
    //
    // Two historical bugs have been fixed here — document both so future edits
    // don't re-introduce them:
    //
    //  Bug 1 — `'participantIds' in null`:
    //    When `get()` is called for a non-existent document, the Firestore rules
    //    engine returns a resource-like object whose `.data` field is `null`.
    //    Using the `in` operator on `null` causes a rules evaluation error which
    //    surfaces as a PERMISSION_DENIED — even for legitimate participants of a
    //    conversation that is being created (race condition) or just deleted.
    //    Fix: guard `d != null` before any field access.
    //
    //  Bug 2 — `'participantIds' in d` on legacy docs:
    //    Conversations created before the `participantIds` field was introduced
    //    do not have the field at all. The `in` operator throws on missing map
    //    keys in some Firestore rules versions.
    //    Fix: use the safe map accessor `d.get('participantIds', null)` which
    //    returns `null` (not an error) when the key is absent.
    //
    // Security note on the legacy-doc fallback (`d.get('participantIds', null) == null`):
    //   Legacy docs won't appear in the participantIds array-contains queries that
    //   every client uses, so they are not discoverable via normal listing. An
    //   attacker would need to know the private auto-generated convId to reach them.
    function isConvParticipant(convId) {
      let d = get(/databases/$(database)/documents/conversations/$(convId)).data;
      // d is null  → conversation does not exist → deny (false)
      // participantIds absent → legacy doc → permit (null == null is true)
      // participantIds present → check membership
      return d != null
          && (d.get('participantIds', null) == null
              || request.auth.uid in d.participantIds);
    }

    match /conversations/{convId} {
      // read: allow participant reads AND non-existent-doc reads (resource==null means
      // the doc doesn't exist; accessing resource.data on null would throw → denied,
      // so we guard with resource != null to let onSnapshot return an empty snapshot).
      // Use .get() accessor (not 'in') to avoid throwing on missing participantIds.
      allow read: if isAuthenticated()
          && (resource == null
              || resource.data.get('participantIds', null) == null
              || request.auth.uid in resource.data.participantIds);

      // update: participants may update conversation metadata (lastMessage, unreadCounts,
      // seenBy, etc.).  Legacy docs without participantIds are treated as open to any
      // authenticated user (they will be backfilled with participantIds on next access).
      allow update: if isAuthenticated()
          && resource != null
          && (resource.data.get('participantIds', null) == null
              || request.auth.uid in resource.data.participantIds);

      allow create: if isAuthenticated()
          && request.auth.uid in request.resource.data.participantIds;
    }

    match /conversations/{convId}/messages/{msgId} {
      allow read: if isAuthenticated() && isConvParticipant(convId);

      // Create: sender must claim their own UID in senderId.
      allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid;

      // ── Message mutations (previously missing — every update was denied) ─────
      //
      // Each branch uses affectedKeys() to allow only the specific fields that a
      // given client operation touches, so participants cannot freely overwrite
      // immutable fields like senderId or createdAt.
      //
      // Operations covered:
      //   Emoji reactions  — any participant (tap to add, tap again to remove)
      //   Delivery/read    — any participant (marked automatically on receipt)
      //   Delete for me    — any participant (appends own UID to deletedFor)
      //   Edit content     — only the original sender
      //   Delete for all   — original sender or moderator (zeroes out content)
      allow update: if isAuthenticated()
          && isConvParticipant(convId)
          && (
            // Reactions — any participant toggles emoji on any message
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions'])

            // Delivery receipt — only the RECIPIENT may mark a message delivered.
            // Guards:
            //  1. Sender cannot write their own delivery receipt (resource.data.senderId != auth.uid)
            //  2. Append-only: new array must include all previous UIDs (no removals)
            //  3. The writing user's own UID must be in the updated array
            || (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['deliveredTo'])
                && resource.data.senderId != request.auth.uid
                && request.resource.data.deliveredTo.hasAll(resource.data.deliveredTo)
                && request.auth.uid in request.resource.data.deliveredTo)

            // Read receipt — only the RECIPIENT may mark a message read.
            // Same guards as deliveredTo, applied to readBy.
            || (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['readBy'])
                && resource.data.senderId != request.auth.uid
                && request.resource.data.readBy.hasAll(resource.data.readBy)
                && request.auth.uid in request.resource.data.readBy)

            // Combined delivery + read — recipient marks both fields in one write.
            || (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['deliveredTo', 'readBy'])
                && resource.data.senderId != request.auth.uid
                && request.resource.data.deliveredTo.hasAll(resource.data.deliveredTo)
                && request.auth.uid in request.resource.data.deliveredTo
                && request.resource.data.readBy.hasAll(resource.data.readBy)
                && request.auth.uid in request.resource.data.readBy)

            // "Delete for me" — appends own UID to deletedFor; does not affect others
            || request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['deletedFor'])

            // Edit — only the original sender may change their own message text
            || (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['editedContent', 'editedAt'])
                && resource.data.senderId == request.auth.uid)

            // "Delete for everyone" — sender (or moderator) nullifies content/media
            || (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['deletedForEveryone', 'editedContent', 'mediaUrl'])
                && (resource.data.senderId == request.auth.uid || isModerator()))
          );
    }

    // Typing indicators — participants only
    match /conversations/{convId}/typing/{userId} {
      allow read:  if isAuthenticated() && isConvParticipant(convId);
      allow write: if isOwner(userId);
    }

    // ── Communities ───────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isModerator();
    }

    // ── Follows ───────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── User subcollections (saved/liked posts, joined communities) ───────────
    match /users/{userId}/saved_posts/{postId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/liked_posts/{postId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/joined_communities/{communityId} {
      allow read, write: if isOwner(userId);
    }

    // ── FCM device tokens ─────────────────────────────────────────────────────
    // Only the owner can manage their own device tokens; no other client may
    // read them. The server (Admin SDK) bypasses these rules entirely.
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isOwner(userId);
    }

    // ── Following / followers subcollections ──────────────────────────────────
    // followUser() writes to users/{uid}/following/{targetId} and
    // users/{targetId}/followers/{uid}. Without explicit rules for subcollections
    // the parent /users/{userId} rule does NOT cover them automatically.
    match /users/{userId}/following/{targetId} {
      allow read:  if isAuthenticated();
      // Only the follower can add/remove their own follow
      allow write: if isOwner(userId);
    }

    match /users/{userId}/followers/{followerId} {
      allow read:  if isAuthenticated();
      // Written by the person doing the following (their own uid == followerId)
      allow write: if isAuthenticated() && request.auth.uid == followerId;
    }

    // ── User warnings (issued by moderators) ─────────────────────────────────
    match /userWarnings/{warningId} {
      // Warned user can read their own warnings; moderators see all
      allow read:   if isAuthenticated()
          && (resource.data.userId == request.auth.uid || isModerator());
      // Only moderators may issue, update, or delete warnings
      allow create, update, delete: if isModerator();
    }

    // ── Calls (WebRTC signaling) ───────────────────────────────────────────────
    match /calls/{callId} {
      allow read: if isAuthenticated()
          && (resource.data.callerId == request.auth.uid
              || resource.data.calleeId == request.auth.uid);
      allow create: if isAuthenticated()
          && request.resource.data.callerId == request.auth.uid;
      // Both parties can update status/answer
      allow update: if isAuthenticated()
          && (resource.data.callerId == request.auth.uid
              || resource.data.calleeId == request.auth.uid);
      // Participants may clean up call docs
      allow delete: if isAuthenticated()
          && (resource.data.callerId == request.auth.uid
              || resource.data.calleeId == request.auth.uid);

      // ICE candidates subcollections — each side writes only their own candidates
      match /callerCandidates/{candidateId} {
        allow read: if isAuthenticated()
            && (resource.data == null
                || get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
                || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
        // Only the caller may add their own ICE candidates
        allow create: if isAuthenticated()
            && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
        allow delete: if isAuthenticated()
            && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if isAuthenticated()
            && (resource.data == null
                || get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
                || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
        // Only the callee may add their own ICE candidates
        allow create: if isAuthenticated()
            && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
        allow delete: if isAuthenticated()
            && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
      }
    }

    // ── Stories ───────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid;

      // Author or moderator can update anything.
      // Any authenticated viewer can update ONLY the viewerIds array (mark as viewed).
      // The hasOnly+hasAll combo ensures: only viewerIds changes, and only new entries
      // are added (no removals), so viewers can't tamper with other fields or remove others.
      allow update:
          if (isAuthenticated() && resource.data.authorId == request.auth.uid)
          || isModerator()
          || (isAuthenticated()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerIds'])
              && request.resource.data.viewerIds.hasAll(resource.data.viewerIds));

      // Delete is strictly author/moderator — no viewer shortcut.
      allow delete:
          if (isAuthenticated() && resource.data.authorId == request.auth.uid)
          || isModerator();

      // Story reactions — one document per user, keyed by userId.
      // Any authenticated viewer may react; only they can change or remove it.
      match /reactions/{userId} {
        // Everyone can see the reaction count/list (used for activity panel).
        allow read: if isAuthenticated();
        // The reacting user writes their own reaction doc (userId == their uid).
        allow create, update: if isOwner(userId)
            && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      // Story comments — private (Instagram-style direct replies to the author).
      // The author sees all comments in the activity panel; the commenter sees
      // their own comment immediately. Others cannot read this subcollection.
      match /comments/{commentId} {
        // Readable by the story author or the comment's own author.
        allow read: if isAuthenticated()
            && (get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
                || resource.data.authorId == request.auth.uid);
        // Any authenticated user may leave a comment, but must claim their own uid.
        allow create: if isAuthenticated()
            && request.resource.data.authorId == request.auth.uid;
        // Only the commenter or a moderator may edit/delete.
        allow update, delete:
            if (isAuthenticated() && resource.data.authorId == request.auth.uid)
            || isModerator();
      }
    }

    // ── Daily Spark gate (one answer per UID per ET date) ─────────────────────
    // Document ID is always `{uid}_{YYYY-MM-DD}` so it is deterministic and
    // ownership can be verified without a subcollection lookup.
    //
    // `allow create` only (no update / delete) makes the gate write-once:
    // a second write from any device is rejected server-side.  Client-side
    // protection (shared context + Firestore transaction) also prevents
    // duplicates, but these rules are the authoritative backend enforcement.
    match /dailySparkResponses/{responseId} {
      // resource == null when the document doesn't exist yet (new user checking
      // before their first answer). Accessing resource.data on null throws a
      // rules evaluation error → PERMISSION_DENIED. Allow the read so getDoc()
      // returns an empty snapshot (no data exposed), then verify uid when doc exists.
      allow read: if isAuthenticated()
          && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated()
          && request.resource.data.uid == request.auth.uid
          && responseId == request.auth.uid + '_' + request.resource.data.sparkDateKey;
      // No update or delete — the gate is permanent for the day it was written.
      allow update, delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Founder UID — hardcoded server-side, never editable from client ─────────
    // This string MUST match FOUNDER_UID in src/lib/founder.ts
    function isFounder() {
      return request.auth != null
          && request.auth.uid == 'OJzzcq17QLRreaEINhQ2czxhtQ23';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Founder OR a user listed in the admins collection
    function isModerator() {
      return isFounder()
          || (isAuthenticated()
              && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();

      // New account creation
      allow create: if isOwner(userId);

      // Self-update: block all role / suspension / ban / founder fields
      allow update: if isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'isFounder', 'isAdmin', 'isModerator',
                       'suspended', 'banned', 'suspendedAt', 'bannedAt']);

      // Founder can update any user (e.g. to set role fields)
      allow update, delete: if isFounder();
    }

    // ── Protected roles document ───────────────────────────────────────────────
    match /roles/{document} {
      allow read:  if isModerator();
      allow write: if isFounder();
    }

    // ── Admin roster ──────────────────────────────────────────────────────────
    match /admins/{userId} {
      allow read:  if isModerator();
      allow write: if isFounder();   // Only Founder grants/revokes moderator roles
    }

    // ── Reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Any authenticated user may create a report for their own UID
      allow create: if isAuthenticated()
          && request.resource.data.reporterId == request.auth.uid;

      // Reporters can read their own submitted reports
      // Moderators can read everything
      allow read: if isModerator()
          || (isAuthenticated() && resource.data.reporterId == request.auth.uid);

      // Only moderators may update status/assignment; reporters cannot touch status
      allow update: if isModerator()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['reporterId', 'targetId', 'reportedUserId']);

      // Only Founder can hard-delete reports
      allow delete: if isFounder();
    }

    // ── Moderation audit log — immutable from client ───────────────────────────
    match /moderationActions/{actionId} {
      allow create: if isModerator();
      allow read:   if isModerator();
      // No update or delete — audit log is append-only
      allow update, delete: if false;
    }

    // ── User suspensions / bans ───────────────────────────────────────────────
    match /userSuspensions/{userId} {
      allow read:  if isOwner(userId) || isModerator();
      allow write: if isModerator();
    }

    // ── Blocks ────────────────────────────────────────────────────────────────
    match /userBlocks/{docId} {
      allow read:   if isAuthenticated()
          && (resource.data.blockerId == request.auth.uid
              || resource.data.blockedId == request.auth.uid);
      allow create: if isAuthenticated()
          && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated()
          && resource.data.blockerId == request.auth.uid;
    }

    // ── Mutes ─────────────────────────────────────────────────────────────────
    match /userMutes/{docId} {
      allow read:   if isAuthenticated()
          && resource.data.muterId == request.auth.uid;
      allow create: if isAuthenticated()
          && request.resource.data.muterId == request.auth.uid;
      allow delete: if isAuthenticated()
          && resource.data.muterId == request.auth.uid;
    }

    // ── Restrictions ──────────────────────────────────────────────────────────
    match /userRestrictions/{docId} {
      allow read:   if isAuthenticated()
          && resource.data.restrictorId == request.auth.uid;
      allow create: if isAuthenticated()
          && request.resource.data.restrictorId == request.auth.uid;
      allow delete: if isAuthenticated()
          && resource.data.restrictorId == request.auth.uid;
    }

    // ── Safety settings ───────────────────────────────────────────────────────
    match /userSafetySettings/{userId} {
      allow read, write: if isOwner(userId) || isModerator();
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.authorId == request.auth.uid)
          || isModerator();
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid)
          || isModerator();

      // Comments are stored as a subcollection of each post
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
            && request.resource.data.authorId == request.auth.uid;
        allow update, delete:
            if (isAuthenticated() && resource.data.authorId == request.auth.uid)
            || isModerator();

        // Replies are nested under each comment
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated()
              && request.resource.data.authorId == request.auth.uid;
          allow update, delete:
              if (isAuthenticated() && resource.data.authorId == request.auth.uid)
              || isModerator();
        }
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Recipient reads and manages their own
      allow read, update, delete: if isAuthenticated()
          && resource.data.userId == request.auth.uid;
      // Any authenticated user may write (send a notification to another user)
      allow create: if isAuthenticated();
    }

    // ── Conversations ─────────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read, update: if isAuthenticated()
          && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated()
          && request.auth.uid in request.resource.data.participantIds;
    }

    match /conversations/{convId}/messages/{msgId} {
      allow read: if isAuthenticated()
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId))
             .data.participantIds;
      allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid;
    }

    // Typing indicators — participants only
    match /conversations/{convId}/typing/{userId} {
      allow read: if isAuthenticated()
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId))
             .data.participantIds;
      allow write: if isOwner(userId);
    }

    // ── Communities ───────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isModerator();
    }

    // ── Follows ───────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── User subcollections (saved/liked posts, joined communities) ───────────
    match /users/{userId}/saved_posts/{postId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/liked_posts/{postId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/joined_communities/{communityId} {
      allow read, write: if isOwner(userId);
    }

    // ── FCM device tokens ─────────────────────────────────────────────────────
    // Only the owner can manage their own device tokens; no other client may
    // read them. The server (Admin SDK) bypasses these rules entirely.
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isOwner(userId);
    }

    // ── Following / followers subcollections ──────────────────────────────────
    // followUser() writes to users/{uid}/following/{targetId} and
    // users/{targetId}/followers/{uid}. Without explicit rules for subcollections
    // the parent /users/{userId} rule does NOT cover them automatically.
    match /users/{userId}/following/{targetId} {
      allow read:  if isAuthenticated();
      // Only the follower can add/remove their own follow
      allow write: if isOwner(userId);
    }

    match /users/{userId}/followers/{followerId} {
      allow read:  if isAuthenticated();
      // Written by the person doing the following (their own uid == followerId)
      allow write: if isAuthenticated() && request.auth.uid == followerId;
    }

    // ── User warnings (issued by moderators) ─────────────────────────────────
    match /userWarnings/{warningId} {
      // Warned user can read their own warnings; moderators see all
      allow read:   if isAuthenticated()
          && (resource.data.userId == request.auth.uid || isModerator());
      // Only moderators may issue, update, or delete warnings
      allow create, update, delete: if isModerator();
    }

    // ── Calls (WebRTC signaling) ───────────────────────────────────────────────
    match /calls/{callId} {
      allow read: if isAuthenticated()
          && (resource.data.callerId == request.auth.uid
              || resource.data.calleeId == request.auth.uid);
      allow create: if isAuthenticated()
          && request.resource.data.callerId == request.auth.uid;
      // Both parties can update status/answer
      allow update: if isAuthenticated()
          && (resource.data.callerId == request.auth.uid
              || resource.data.calleeId == request.auth.uid);
      // Participants may clean up call docs
      allow delete: if isAuthenticated()
          && (resource.data.callerId == request.auth.uid
              || resource.data.calleeId == request.auth.uid);

      // ICE candidates subcollections — each side writes only their own candidates
      match /callerCandidates/{candidateId} {
        allow read: if isAuthenticated()
            && (resource.data == null
                || get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
                || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
        // Only the caller may add their own ICE candidates
        allow create: if isAuthenticated()
            && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
        allow delete: if isAuthenticated()
            && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if isAuthenticated()
            && (resource.data == null
                || get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
                || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
        // Only the callee may add their own ICE candidates
        allow create: if isAuthenticated()
            && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
        allow delete: if isAuthenticated()
            && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid;
      }
    }

    // ── Stories ───────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid;
      allow update, delete:
          if (isAuthenticated() && resource.data.authorId == request.auth.uid)
          || isModerator();
    }

    // ── Daily Spark gate (one answer per UID per ET date) ─────────────────────
    // Document ID is always `{uid}_{YYYY-MM-DD}` so it is deterministic and
    // ownership can be verified without a subcollection lookup.
    //
    // `allow create` only (no update / delete) makes the gate write-once:
    // a second write from any device is rejected server-side.  Client-side
    // protection (shared context + Firestore transaction) also prevents
    // duplicates, but these rules are the authoritative backend enforcement.
    match /dailySparkResponses/{responseId} {
      allow read: if isAuthenticated()
          && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
          && request.resource.data.uid == request.auth.uid
          && responseId == request.auth.uid + '_' + request.resource.data.sparkDateKey;
      // No update or delete — the gate is permanent for the day it was written.
      allow update, delete: if false;
    }
  }
}

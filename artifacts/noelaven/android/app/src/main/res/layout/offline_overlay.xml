<?xml version="1.0" encoding="utf-8"?>
<!--
  Noelaven — Native offline / error screen
  Shown by MainActivity when the device has no internet connection.
  Branded to match the app's dark theme (#0f0f10 background, #EC4899 accent).
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nlv_background">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="40dp"
        android:paddingRight="40dp">

        <!-- Wi-fi off icon -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_wifi_off"
            android:contentDescription="@string/offline_icon_desc"
            android:tint="@color/nlv_pink"
            android:layout_marginBottom="24dp" />

        <!-- App name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/nlv_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="12dp" />

        <!-- Offline message -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_message"
            android:textColor="@color/nlv_text_muted"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="32dp" />

        <!-- Retry button -->
        <Button
            android:id="@+id/btn_retry"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:text="@string/offline_retry"
            android:textColor="@color/nlv_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/nlv_pink"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

    </LinearLayout>

</FrameLayout>
